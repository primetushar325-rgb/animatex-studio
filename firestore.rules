rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }
    
    // Users collection - users can only access their own data
    match /users/{userId} {
      // Read: owner or admin only
      allow read: if isOwner(userId) || isAdmin();
      // Create: only the authenticated user creating their own doc
      allow create: if isOwner(userId);
      // Update: owner only (admin can update via Admin SDK server-side)
      allow update: if isOwner(userId);
      // Delete: admin only (users cannot delete their own accounts via client)
      allow delete: if isAdmin();
      
      // Projects subcollection - strictly private per user
      match /projects/{projectId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
        
        // Scenes within projects
        match /scenes/{sceneId} {
          allow read, write: if isOwner(userId);
        }
        
        // Assets within projects
        match /assets/{assetId} {
          allow read, write: if isOwner(userId);
        }
        
        // Versions within projects
        match /versions/{versionId} {
          allow read, write: if isOwner(userId);
        }
      }

      // Character library — each user manages their own character PNG collection
      match /characterLibrary/{characterId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
    }
    
    // Activity logs - users can read their own, admins can read all
    match /activityLogs/{logId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false; // Logs are immutable
    }
    
    // Admin audit logs - admin only
    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false; // Audit logs are immutable
    }
    
    // App settings - read by all authenticated, write by admin
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Feature flags - read by all authenticated, write by admin
    match /featureFlags/{flagId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Usage limits - read by all authenticated, write by admin
    match /usageLimits/{limitId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Announcements - read by all authenticated, write by admin
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Templates - read by all authenticated, write by admin only
    match /templates/{templateId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

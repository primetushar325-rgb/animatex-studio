# ============================================================
# ANIMATION STUDIO - ENVIRONMENT VARIABLES
# ============================================================
# This application uses Firebase as its backend.
# No PostgreSQL or other SQL database is required.
# ============================================================

# ------------------------------------------------------------
# CLIENT-SIDE FIREBASE CONFIGURATION
# ------------------------------------------------------------
# These variables are exposed to the browser (NEXT_PUBLIC_ prefix)
# Get these from: Firebase Console > Project Settings > Your apps > Web app
# These are safe to commit to public repos (they're public keys)

NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ------------------------------------------------------------
# SERVER-SIDE FIREBASE ADMIN CONFIGURATION
# ------------------------------------------------------------
# These variables are ONLY used server-side (NO NEXT_PUBLIC_ prefix)
# Get these from: Firebase Console > Project Settings > Service Accounts
# Click "Generate new private key" and extract the values
# 
# ⚠️ KEEP THESE SECRET - Never commit real values to version control
# ⚠️ Never expose these in client-side code

FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------
# APPLICATION CONFIGURATION
# ------------------------------------------------------------

# Admin Setup Key - Used to promote the first admin user
# Generate a secure random string and keep it secret
# Usage: POST /api/admin/setup with { email, setupKey }
ADMIN_SETUP_KEY=your_secure_random_key_here

# ------------------------------------------------------------
# OPTIONAL: FIREBASE EMULATORS (for local development)
# ------------------------------------------------------------
# Set to 'true' to use Firebase emulators instead of production
# NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

# ============================================================
# DEPLOYMENT NOTES
# ============================================================
#
# LOCAL DEVELOPMENT:
# 1. Copy this file to .env
# 2. Fill in your Firebase project values
# 3. Run: npm run dev
#
# VERCEL DEPLOYMENT:
# 1. Go to Vercel Dashboard > Your Project > Settings > Environment Variables
# 2. Add all variables listed above
# 3. For FIREBASE_ADMIN_PRIVATE_KEY, paste the entire key including BEGIN/END markers
# 4. Redeploy your application
#
# REQUIRED FOR BASIC FUNCTIONALITY:
# - All NEXT_PUBLIC_FIREBASE_* variables (client auth & Firestore)
#
# REQUIRED FOR ADMIN FEATURES:
# - All FIREBASE_ADMIN_* variables (user management, custom claims)
# - ADMIN_SETUP_KEY (first-time admin setup)
#
# ============================================================
